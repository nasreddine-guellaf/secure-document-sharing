{
  "name": "secure-document-sharing-backend",
  "version": "1.0.0",
  "description": "Backend API for the Secure Document Sharing System student project.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
